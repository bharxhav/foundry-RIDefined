{
  "name": "foundry-ridefined",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev:firefox": "pnpm --filter @foundry-ridefined/extension dev:firefox",
    "dev:chrome": "pnpm --filter @foundry-ridefined/extension dev:chrome",
    "build:firefox": "pnpm --filter @foundry-ridefined/extension build:firefox",
    "build:chrome": "pnpm --filter @foundry-ridefined/extension build:chrome",
    "zip:firefox": "pnpm --filter @foundry-ridefined/extension zip:firefox",
    "zip:chrome": "pnpm --filter @foundry-ridefined/extension zip:chrome",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@eslint/js": "9.33.0",
    "eslint": "9.33.0",
    "globals": "16.3.0",
    "prettier": "3.6.2",
    "typescript-eslint": "8.39.1"
  }
}
