{
  "name": "@foundry-ridefined/extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:firefox": "wxt -b firefox --mv3",
    "dev:chrome": "wxt -b chrome",
    "build:firefox": "wxt build -b firefox",
    "build:chrome": "wxt build -b chrome",
    "zip:firefox": "wxt zip -b firefox",
    "zip:chrome": "wxt zip -b chrome",
    "typecheck": "wxt prepare && tsc --noEmit"
  },
  "dependencies": {
    "@foundry-ridefined/foundry": "workspace:*",
    "@foundry-ridefined/ui": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@wxt-dev/module-react": "1.2.2",
    "@wxt-dev/storage": "1.2.9",
    "typescript": "catalog:",
    "wxt": "0.20.18"
  }
}
